# Copy to .env.local. Server-side only; never expose as NEXT_PUBLIC_*.

# --- Signing secrets (REQUIRED; generate with: openssl rand -base64 32) ---
PASSPORT_SECRET=
STOCK_CHECK_SECRET=

# --- LLM: any OpenAI-compatible provider (tried first when all three are set) ---
# Production currently: Featherless AI
#   FORMA_LLM_BASE_URL=https://api.featherless.ai/v1
#   FORMA_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct   <- agent role needs a tool-call-capable model;
#                                                    small models (e.g. Qwen2-7B) parse briefs but
#                                                    never call recommendProducts.
# Other examples: xAI https://api.x.ai/v1 | Groq https://api.groq.com/openai/v1 | Ollama http://localhost:11434/v1
FORMA_LLM_BASE_URL=
FORMA_LLM_API_KEY=
FORMA_LLM_MODEL=
# Optional multimodal model for image calls (/api/vision, brief surface guess, stock-judge
# screenshot). Falls back to the agent chain when unset. On Featherless use a VL model, e.g.:
# FORMA_LLM_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
FORMA_LLM_VISION_MODEL=
# FORMA_LLM_NAME=featherless

# Featherless (and some other hosts) support json_object but NOT json_schema structured
# outputs; the brief, vision, surface and stock-judge calls already compensate (they spell
# the JSON keys in the prompt and pass structuredOutputs:false + tolerant schemas).

# --- LLM: Vercel AI Gateway (needs a positive credit balance) ---
AI_GATEWAY_API_KEY=
# FORMA_DISABLE_GATEWAY=1
# FORMA_AGENT_MODELS=compatible:grok-4,gateway:openai/gpt-5-mini
# FORMA_FAST_MODELS=

# --- Shared rate-limit counters (Vercel KV or Upstash) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Tools ---
TAVILY_API_KEY=
SOLARI_API_KEY=
BROWSER_USE_API_KEY=
VLMRUN_API_KEY=

# --- Channel3 product catalog (agentic commerce) ---
# Powers catalog offers in the gear agent's product search and the MCP
# find_products tool. Free key at trychannel3.com → Developers.
# CHANNEL3_API_KEY=
# CHANNEL3_COUNTRY=GB      # offer locale
# CHANNEL3_CURRENCY=GBP    # offer currency (PayPal checkout orders are USD)

# --- Shared store (recommended) ---
# Rate-limit counters AND fit-outcome reports live here. Without it, outcomes are logged only
# and limits are per serverless instance.
# KV_REST_API_URL=   KV_REST_API_TOKEN=   (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# --- Optional ---
# ERROR_WEBHOOK_URL=
# FORMA_DISABLED_FEATURES=tryon,deep
# NEXT_PUBLIC_AWIN_AFFILIATE_ID=
# NEXT_PUBLIC_AWIN_MERCHANTS=

# --- PayPal (Pro subscriptions + agentic checkout) ---
# Sandbox app creds from developer.paypal.com → Apps & Credentials.
# PAYPAL_ENV defaults to sandbox; 'live' targets real money.
# PAYPAL_PRO_PLAN_ID pins the £9/mo billing plan — auto-created and reused when unset.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_ENV=
# PAYPAL_PRO_PLAN_ID=

# --- Switch room agent (hackathon): posts a shared passport into a team room ---
# SWITCH_BASE_URL=        Switch server address (from Switch Console)
# SWITCH_AGENT_ID=        from `pnpm switch:register` → switch/.agent.json
# SWITCH_AGENT_API_KEY=
# SWITCH_ROOM_ID=         room the agent posts shared passports into
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_ROOM_ID=
